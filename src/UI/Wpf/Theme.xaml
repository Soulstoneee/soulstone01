<!--
  RestMode theme: ALL colors, fonts and control styles live here.
  Fonts (SIL Open Font License, bundled): Pinyon Script / Great Vibes for
  headings and big labels, Cormorant Garamond for text and numbers.
  The accent color (silver / gold / blue), ornament brightness and animation
  speed are user settings: ThemeManager.cs overrides AccentColor / AccentBrush /
  GlowColor / OrnamentOpacity at runtime.
  The ornaments themselves are original vector art drawn in Ornaments.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ===================================================== colors -->
  <Color x:Key="BackgroundColor">#000000</Color>
  <Color x:Key="PanelColor">#0A0B0D</Color>
  <Color x:Key="SilverColor">#B9BEC6</Color>
  <Color x:Key="SilverDimColor">#6C727B</Color>
  <Color x:Key="TextColor">#ECEEF2</Color>
  <Color x:Key="HintColor">#9298A1</Color>
  <Color x:Key="WarnColor">#E8C27A</Color>
  <!-- Overridden from settings: Silver #DDE2EA, Gold #E6C67E, Blue #A9CCFF -->
  <Color x:Key="AccentColor">#DDE2EA</Color>
  <Color x:Key="GlowColor">#F4F6FA</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="SilverBrush" Color="{StaticResource SilverColor}" />
  <SolidColorBrush x:Key="SilverDimBrush" Color="{StaticResource SilverDimColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="HintBrush" Color="{StaticResource HintColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

  <LinearGradientBrush x:Key="SilverLineBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#8A9099" Offset="0" />
    <GradientStop Color="#E8ECF2" Offset="0.5" />
    <GradientStop Color="#8A9099" Offset="1" />
  </LinearGradientBrush>

  <sys:Double x:Key="OrnamentOpacity">0.55</sys:Double>

  <!-- ===================================================== text -->
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource ScriptFont}" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource Heading}">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Margin" Value="0,14,0,2" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Label}">
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
    <Setter Property="Margin" Value="0,1,0,6" />
  </Style>
  <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
  </Style>

  <!-- ===================================================== tooltips -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SilverDimBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- ===================================================== small utility button -->
  <Style x:Key="SmallButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="14,4" />
    <Setter Property="Margin" Value="0,4,10,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="b" BorderBrush="{DynamicResource SilverDimBrush}" BorderThickness="1" Background="#00000000" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <!-- corner ticks -->
            <Path Data="M0,6 L0,0 L6,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0" />
            <Path Data="M0,0 L6,0 L6,6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
            <Path Data="M0,0 L0,6 L6,6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3" />
            <Path Data="M6,0 L6,6 L0,6" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="b" Property="Effect">
                <Setter.Value><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.7" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="b" Property="Effect">
                <Setter.Value><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.7" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== checkbox: a small ornate diamond -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Margin" Value="0,6,0,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
              <Path x:Name="frame" Data="M11,1 L21,11 L11,21 L1,11 Z" Stroke="{DynamicResource SilverDimBrush}" StrokeThickness="1.2" />
              <Path x:Name="fill" Data="M11,5 L17,11 L11,17 L5,11 Z" Fill="{DynamicResource AccentBrush}" Opacity="0">
                <Path.Effect><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.9" /></Path.Effect>
              </Path>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="fill" Property="Opacity" Value="1" />
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource GlowBrushSolid}" />
              <Setter TargetName="frame" Property="StrokeThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="GlowBrushSolid" Color="{StaticResource GlowColor}" />

  <!-- ===================================================== radio button: a small ornate circle -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Margin" Value="0,5,0,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0">
              <Ellipse x:Name="frame" Stroke="{DynamicResource SilverDimBrush}" StrokeThickness="1.2" />
              <Ellipse x:Name="fill" Margin="6" Fill="{DynamicResource AccentBrush}" Opacity="0">
                <Ellipse.Effect><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="fill" Property="Opacity" Value="1" />
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="frame" Property="StrokeThickness" Value="2" />
              <Setter TargetName="frame" Property="Stroke" Value="{DynamicResource GlowBrushSolid}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== text box -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SilverDimBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="#0E1013" BorderBrush="{DynamicResource SilverDimBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== slider: thin line, diamond thumb -->
  <Style x:Key="ThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Path Data="M8,0 L16,8 L8,16 L0,8 Z" Width="16" Height="16" Fill="{DynamicResource AccentBrush}">
            <Path.Effect><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8" /></Path.Effect>
          </Path>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="22">
            <Rectangle Height="1" Fill="{DynamicResource SilverDimBrush}" VerticalAlignment="Center" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ThumbStyle}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== combo box -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="#0E1013" BorderBrush="{DynamicResource SilverDimBrush}" BorderThickness="1">
            <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="8,4,30,4" IsHitTestVisible="False" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="2,0,26,0" IsReadOnly="{TemplateBinding IsReadOnly}" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="#050506" BorderBrush="{DynamicResource SilverDimBrush}" BorderThickness="1"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                <ScrollViewer><StackPanel IsItemsHost="True" /></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="toggle" Property="Effect">
                <Setter.Value><DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.6" /></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SerifFont}" />
    <Setter Property="Typography.NumeralStyle" Value="Lining" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="b" Property="Background" Value="#1A1D22" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== scrollbar: a thin silver line -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Rectangle Width="2" Fill="{DynamicResource SilverDimBrush}" RadiusX="1" RadiusY="1" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
