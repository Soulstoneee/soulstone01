<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RestMode - PS4-style "Rest Mode" for Windows 10/11.
    Build a single self-contained .exe: run build.cmd (or build.ps1) from the
    repository folder. See README.md for the exact dotnet publish command.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- WPF for the windows, WinForms only for the tray icon and the hidden message window. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RestMode</AssemblyName>
    <RootNamespace>RestMode</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>RestMode.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>RestMode</Product>
    <Description>PS4-style Rest Mode for Windows: screen off, quiet and low power, downloads keep running.</Description>
    <Copyright>MIT License</Copyright>
    <!-- Lets the project also be compiled (not run) on Linux/macOS build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Single-file publish settings (only used by `dotnet publish`). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <!-- Only ship English framework resources (keeps the .exe smaller). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WinForms/WPF + COM interop are not trim-safe; never trim this app. -->
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share many type names (Application, Button, Color...): no global WinForms usings;
         files that use WinForms say so explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI access for the network adapter "allow the computer to turn off this device" flag and vendor fan modes. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts (SIL Open Font License, see Assets/Fonts/OFL-*.txt) and the theme file. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Page Remove="UI\Wpf\Theme.xaml" />
    <EmbeddedResource Include="UI\Wpf\Theme.xaml" LogicalName="RestMode.Theme.xaml" />
    <Resource Include="RestMode.ico" />
  </ItemGroup>

</Project>
